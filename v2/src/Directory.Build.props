<Project>
    <PropertyGroup>
        <TargetGameName>Firestone</TargetGameName>
        <GameRoot Condition="'$(COMMON_DIR)' != ''">$(COMMON_DIR)\$(TargetGameName)</GameRoot>
        <GameRoot Condition="'$(GameRoot)' == ''">C:\Program Files (x86)\Steam\steamapps\common\$(TargetGameName)</GameRoot>
    </PropertyGroup>

    <PropertyGroup>
        <MelonLoaderDir>$(GameRoot)\MelonLoader</MelonLoaderDir>
        <MelonLoaderNetDir>$(MelonLoaderDir)\net6</MelonLoaderNetDir>
        <Il2CppAssembliesDir>$(MelonLoaderDir)\Il2CppAssemblies</Il2CppAssembliesDir>
        <!-- Deliberately NOT $(GameRoot)\Mods: same dll/mod name as v1, so auto-deploying there on
             every build would silently overwrite the working v1 mod with whatever's done so far.
             Builds land in v2/dist/ instead; copy to the game's Mods folder by hand when it's
             actually ready to test in place of v1. -->
        <ModsDir>$(MSBuildThisFileDirectory)..\dist</ModsDir>
    </PropertyGroup>

    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <Platforms>x64</Platforms>
        <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>

    <PropertyGroup>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    </PropertyGroup>
</Project>
